@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="auth-card">
    <h1>Bienvenido de vuelta, EcoWarrior</h1>
    <p>Continúa tu progreso y ayuda a tu ciudad con acciones reales.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>Correo</label><input asp-for="Email" class="form-control" />
        <label class="mt-3">Contraseña</label><input asp-for="Password" class="form-control" />
        <button class="btn btn-success w-100 mt-4">Ingresar</button>
    </form>
</div>
