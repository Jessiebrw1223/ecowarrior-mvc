<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EcoWarrior</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">🌱 EcoWarrior</div>
        <a href="/" class="nav-link">Inicio</a>
        <a href="/Challenges" class="nav-link">Retos</a>
        <a href="/Ranking" class="nav-link">Clasificación</a>
        <a href="/Profile" class="nav-link">Perfil</a>
        <a href="/Contact" class="nav-link">Contacto</a>
        <a href="/AiAgent" class="nav-link">EcoGuide AI</a>
        <hr />
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <span class="user-pill">@Context.Session.GetString("UserName")</span>
            <a href="/Account/Logout" class="nav-link text-danger">Cerrar sesión</a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-success w-100 mt-2">Ingresar</a>
            <a href="/Account/Register" class="btn btn-outline-success w-100 mt-2">Crear cuenta</a>
        }
    </aside>
    <main class="content">
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
